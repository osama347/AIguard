{
  "server": {
    "host": "0.0.0.0",
    "port": 8090,
    "threads": 16,
    "max_upload_mb": 1024
  },
  "paths": {
    "data_dir": "../../data",
    "migrations_dir": "../migrations",
    "frontend_dir": "../../../frontend/dist"
  },
  "inference": {
    "url": "http://127.0.0.1:8081",
    "secret": "",
    "sample_fps": 5,
    "max_attempts": 3
  },
  "policy": {
    "match_threshold": 0.55,
    "min_face_frames": 1,
    "min_plate_reads": 1
  },
  "live": {
    "visit_gap_s": 4,
    "max_visit_s": 60,
    "min_visit_frames": 2,
    "repeat_suppress_s": 30,
    "snapshot_retention_days": 30,
    "min_free_disk_mb": 2048,
    "offline_alert_s": 30
  },
  "auth": {
    "session_hours": 12
  },
  "logging": {
    "level": "info"
  }
}
