#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    case "$1" in
        remove|deconfigure)
            systemctl disable --now guard-core.service guard-inference.service >/dev/null 2>&1 || true
            ;;
        upgrade)
            systemctl stop guard-core.service guard-inference.service >/dev/null 2>&1 || true
            ;;
    esac
fi
exit 0
